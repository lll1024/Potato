# 模型名称由所用服务提供，不在此固定模型版本。
MODEL_ID=your-model-id

# 上下文维护默认关闭；启用时必须填写服务实际支持的模型容量（tokens），不能猜测。
CONTEXT_COMPACTION_ENABLED=false
MODEL_CONTEXT_WINDOW=
ANTHROPIC_API_KEY=your-model-api-key

# 使用兼容服务时填写；官方 Anthropic 服务可留空。
ANTHROPIC_BASE_URL=

# 在高德开放平台申请“Web 服务”类型 Key。
AMAP_MAPS_API_KEY=your-amap-web-service-key
