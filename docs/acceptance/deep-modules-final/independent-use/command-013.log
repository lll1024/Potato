19:         self.assertEqual(json.loads(material.context_checkpoint.state_json)["messages"], saved)
20:         context.append_answer("完成")
21:         continued = ModelContext.begin("继续比较", continuation=context.continuation())
22:         self.assertEqual(json.loads(continued.material().messages_json), saved + [
23:             {"role": "assistant", "content": "完成"}, {"role": "user", "content": "继续比较"}])
