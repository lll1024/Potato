14: class Continuation:
15:     """不透明的进程内延续凭证；只持有冻结快照。"""
16:     def __init__(self, seed: PlanningSeed):
17:         self._seed = seed
18: 
19: 
20: class ModelContext:
21:     def __init__(self, seed: PlanningSeed):
22:         try:
23:             self._messages = json.loads(seed.messages_json)
24:             if not isinstance(self._messages, list):
25:                 raise ValueError("原始协议必须是消息列表。")
26:             state = json.loads(seed.context_json) if seed.context_json else None
27:             self._view = ContextView.from_state(state, self._messages) if state else ContextView.from_history(self._messages)
28:             self._date_context = json.loads(seed.date_context_json) if seed.date_context_json else None
29:             self._source_materials = json.loads(seed.source_materials_json)
30:         except Exception:
31:             raise RecordAbort("完整上下文无法恢复，查询未启动。", kind="turn.context") from None
32: 
33:     @property
34:     def summary_blocked(self) -> bool:
35:         """认证或额度故障后，摘要不能继续占用共享模型请求。"""
36:         return self._summary_blocked
37: 
38:     @classmethod
39:     def begin(cls, text: str, *, seed: PlanningSeed | None = None, continuation: Continuation | None = None) -> "ModelContext":
40:         if seed is not None and continuation is not None:
41:             raise ValueError("持久上下文与进程内延续凭证只能选择一个。")
42:         context = cls(continuation._seed if continuation else seed or PlanningSeed())
43:         try:
44:             context._append({"role": "user", "content": text})
45:         except Exception:
46:             raise RecordAbort("完整上下文无法恢复，查询未启动。", kind="turn.context") from None
47:         return context
48: 
49:     @property
50:     def previous_date_context(self) -> dict[str, Any] | None:
51:         return copy.deepcopy(self._date_context)
52: 
53:     @property
54:     def source_materials(self) -> list[dict[str, Any]]:
55:         return copy.deepcopy(self._source_materials)
56: 
57:     @property
58:     def latest_input(self) -> str:
59:         return next((message["content"] for message in reversed(self._messages)
60:                      if message["role"] == "user" and isinstance(message["content"], str)), "")
61: 
62:     def _append(self, message):
63:         self._messages.append(copy.deepcopy(message))
64:         self._view.append(message, len(self._messages))
65: 
66:     def append_response(self, content: list[dict[str, Any]]) -> None:
67:         self._append({"role": "assistant", "content": content})
68: 
69:     def append_tool_results(self, results: Sequence[Mapping[str, Any]]) -> None:
70:         response = self._messages[-1]
71:         content = response.get("content")
72:         expected = [block["id"] for block in content if block.get("type") == "tool_use"] if (
73:             response["role"] == "assistant" and isinstance(content, list)) else []
74:         actual = [block["tool_use_id"] for block in results if block.get("type") == "tool_result"]
75:         if not expected or len(actual) != len(results) or sorted(actual) != sorted(expected):
76:             raise ValueError("完整工具结果必须与上一响应的调用身份一一配对。")
77:         self._append({"role": "user", "content": results})
78: 
79:     def append_answer(self, answer: str, *, replace_response: bool = False) -> None:
80:         message = {"role": "assistant", "content": answer}
81:         if replace_response:
82:             self._messages[-1] = message
83:             self._view.messages[-1] = copy.deepcopy(message)
84:         else:
85:             self._append(message)
86: 
87:     def material(self, redact: Callable[[str], str] = lambda value: value) -> TurnMaterial:
88:         try:
89:             return TurnMaterial(redact(json.dumps(self._messages, ensure_ascii=False)),
90:                                 ContextCheckpoint.capture(json.loads(redact(json.dumps(self._view.to_state(), ensure_ascii=False)))))
91:         except Exception:
92:             raise RecordAbort("轮次保存材料无法生成；仅保留最后成功提交的事实。", kind="turn.finished") from None
93: 
94:     def continuation(self) -> Continuation:
95:         material = self.material()
96:         assert material.context_checkpoint is not None
97:         return Continuation(PlanningSeed(messages_json=material.messages_json,
98:             context_json=material.context_checkpoint.state_json,
99:             date_context_json=json.dumps(self._date_context, ensure_ascii=False)))
100: 
101:     def configure(self, *, policy: ContextPolicy | None, model: str, client, tools, date_context: dict[str, Any] | None,
102:                   next_request_ordinal, remaining_requests, observer, stop_requested, history_records=None):
103:         self._messages = json.loads(tools.redact(json.dumps(self._messages, ensure_ascii=False)))
104:         self._view.messages = json.loads(tools.redact(json.dumps(self._view.messages, ensure_ascii=False)))
105:         self._policy = policy
106:         self._meter = TokenMeter(model, usage_semantics="anthropic" if not os.getenv("ANTHROPIC_BASE_URL") else "compatible_unknown")
107:         self._client, self._tools = client, tools
108:         self._date_context, self._turn_start = copy.deepcopy(date_context), len(self._messages) - 1
109:         self._next_request_ordinal, self._remaining_requests = next_request_ordinal, remaining_requests
110:         self._observer, self._stop_requested = observer, stop_requested
111:         self._summary_attempts, self._summary_blocked = 0, False
112:         self._measurement: dict[str, Any] | None = None
113:         self._recovery_steps = set()
114:         self._history_records = history_records
115:         self._history = SessionHistory(self._records)
116: 
117:     def _records(self, partial_results=()):
118:         protocol = [*self._messages, {"role": "user", "content": list(partial_results)}] if partial_results else self._messages
119:         return bind_protocol_references(self._history_records(), protocol) if self._history_records else protocol_records(protocol)
120: 
121:     async def read_history(self, name, arguments, *, parameters, completed, pending, tool_use_id, observer=None):
122:         def fits(content):
123:             remaining = [{"type": "tool_result", "tool_use_id": identifier, "content": "", "is_error": True} for identifier in pending]
124:             return self._fits_tool_results(parameters, [*completed,
125:                 {"type": "tool_result", "tool_use_id": tool_use_id, "content": content, "is_error": False}, *remaining])
126:         self._history.records = lambda: self._records(completed)
127:         return await self._history.call(name, arguments, observer=observer, fits=fits)
128: 
129:     async def recovery_started(self, data):
130:         await self._emit("context.recovery_started", {**data, "version": self._view.version})
131: 
132:     async def _emit(self, kind, data):
133:         if self._observer:
134:             await self._observer(kind, data)
135: 
136:     def _measure_view(self, parameters):
137:         parameters["messages"] = copy.deepcopy(self._view.messages)
138:         return self._meter.measure(parameters)
139: 
140:     def _within_budget(self, measurement):
141:         return self._policy is not None and measurement["estimated_tokens"] <= self._policy.input_budget
142: 
143:     async def _organize(self, parameters, measurement, *, step, attempt, recovery=False):
144:         before_tokens = measurement["estimated_tokens"]
145:         changed = self._view.organize_tool_results()
146:         measurement = self._measure_view(parameters)
147:         data = {"before_tokens": before_tokens, "after_tokens": measurement["estimated_tokens"],
148:                 "changed_result_count": changed,
149:                 "pressure_remaining": self._policy is None or measurement["estimated_tokens"] >= self._policy.pressure_threshold,
150:                 "original_watermark": self._view.original_watermark, "version": self._view.version,
151:                 "record_ids": self._view.record_ids.copy(), "step": step, "attempt": attempt}
152:         if not recovery:
153:             assert self._policy is not None
154:             data["pressure_threshold"] = self._policy.pressure_threshold
155:         await self._emit("context.organized", data)
156:         return measurement
157: 
158:     async def _summarize(self, parameters, *, force=False):
159:         if self._policy is None or self._summary_attempts >= 4 or self._summary_blocked or not self._remaining_requests():
160:             return
161:         result = await summarize_history(
162:             view=self._view, policy=self._policy, meter=self._meter, parameters=parameters,
163:             client=self._client, tools=self._tools, date_context=self._date_context,
164:             cutoff=earlier_history_cutoff(self._view, self._turn_start, self._policy, self._meter, force=force),
165:             remaining_attempts=min(4 - self._summary_attempts, self._remaining_requests()), next_request_ordinal=self._next_request_ordinal,
166:             observer=self._observer, stop_requested=self._stop_requested)
167:         self._summary_attempts += result.attempts
168:         self._summary_blocked = self._summary_blocked or result.terminal_failure
169: 
170:     async def prepare_request(self, parameters, *, step, attempt, recovering=False, final=False):
171:         """更新可发送的输入；返回预算阻止原因，关闭压缩时沿用原输入。"""
172:         parameters["messages"] = copy.deepcopy(self._view.messages)
173:         measurement = self._meter.measure(parameters) if self._policy else None
174:         self._measurement = measurement
175:         if self._policy is None:
176:             return None
177:         assert measurement is not None
178:         if not final and not recovering and measurement["estimated_tokens"] >= self._policy.pressure_threshold:
179:             measurement = await self._organize(parameters, measurement, step=step, attempt=attempt)
180:             if (measurement["estimated_tokens"] >= self._policy.pressure_threshold
181:                     and self._summary_attempts < 4 and not self._summary_blocked):
182:                 await self._summarize(parameters)
183:                 measurement = self._measure_view(parameters)
184:         self._measurement = measurement
185:         allowed = self._within_budget(measurement)
186:         await self._emit("context.checked", {**measurement, "window": self._policy.window,
187:             "input_budget": self._policy.input_budget, "allowed": allowed,
188:             "original_watermark": self._view.original_watermark, "version": self._view.version,
189:             "record_ids": self._view.record_ids.copy(), "step": step, "attempt": attempt})
190:         return None if allowed else "context_budget"
191: 
192:     async def prepare_recovery(self, parameters, *, request_id, step, attempt):
193:         """仅允许预算内且严格缩小的输入恢复；同一模型步骤只允许一次。"""
194:         if step in self._recovery_steps:
195:             return "context_window_exceeded"
196:         self._recovery_steps.add(step)
197:         measurement = self._meter.measure(parameters)
198:         before_tokens = measurement["estimated_tokens"]
199:         measurement = await self._organize(parameters, measurement, step=step, attempt=attempt, recovery=True)
200:         if measurement["estimated_tokens"] >= before_tokens or not self._within_budget(measurement):
201:             await self._summarize(parameters, force=True)
202:         self._measurement = self._measure_view(parameters)
203:         after_tokens = self._measurement["estimated_tokens"]
204:         allowed = self._within_budget(self._measurement)
205:         reduced = after_tokens < before_tokens
206:         await self._emit("context.recovery_prepared", {"request_id": request_id,
207:             "before_tokens": before_tokens, "after_tokens": after_tokens,
208:             "reduced": reduced, "allowed": allowed, "step": step,
209:             "summary_attempts": self._summary_attempts, "version": self._view.version})
210:         return None if reduced and allowed else "context_recovery_unavailable"
211: 
212:     async def observe_usage(self, request_id, usage):
213:         if self._measurement is not None:
214:             calibration = self._meter.observe_usage(usage, self._measurement)
215:             await self._emit("context.usage", {"request_id": request_id, **calibration})
216: 
217:     def _fits_tool_results(self, parameters, results):
218:         """历史回读页面与未完成工具结果一起参与完整请求预算。"""
219:         if self._policy is None:
220:             return True
221:         projected = copy.deepcopy(parameters)
222:         projected["messages"] = copy.deepcopy(self._view.messages) + [{"role": "user", "content": results}]
223:         return self._within_budget(self._meter.measure(projected))

